// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum VideoStatus {
  PENDING
  GENERATING_ASSETS
  AWAITING_REVIEW
  RENDERING
  COMPLETED
  FAILED
}

model Video {
  id                      String      @id @default(uuid())
  status                  VideoStatus @default(PENDING)
  title                   String
  scriptText              String
  audioPath               String?     // Для совместимости, основные аудио в segments
  videoPath               String?
  segments                String?     // JSON массив сегментов: [{text, keywords, audioPath, audioDuration, stockVideoUrl}]
  progress                String?     // JSON с детальным прогрессом
  backgroundMusicUrl      String?     // URL фоновой музыки (для стриминга)
  backgroundMusicFilename String?     // Имя/название трека
  backgroundMusicData     String?     // JSON с полными данными музыки из Jamendo
  tags                    String?     // JSON массив тегов для YouTube
  hashtags                String?     // JSON массив хештегов для описания (#cats #коты)
  
  // YouTube публикация
  youtubeId          String?     // ID видео на YouTube
  youtubeUrl         String?     // URL видео на YouTube
  youtubeStatus      String?     // Статус: private, public, unlisted
  publishedAt        DateTime?   // Дата публикации
  youtubeChannelId   String?     // ID канала на который опубликовано
  
  // Настройки голоса
  voiceConfigId      String?     // ID выбранного голоса

  createdAt          DateTime    @default(now())
  
  youtubeChannel     YouTubeChannel? @relation(fields: [youtubeChannelId], references: [id])
  videoVersions      VideoVersion[]
}

// YouTube OAuth Credentials (для разных Google аккаунтов)
model YouTubeCredentials {
  id           String   @id @default(uuid())
  name         String   // Название для удобства (например "Личный аккаунт", "Рабочий")
  clientId     String   // OAuth Client ID
  clientSecret String   // OAuth Client Secret
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  channels     YouTubeChannel[]
}

// YouTube каналы (для мультиканальности)
model YouTubeChannel {
  id              String   @id @default(uuid())
  channelId       String   @unique  // ID канала на YouTube (UCxxxx)
  title           String            // Название канала
  thumbnail       String?           // URL аватарки
  subscriberCount String?           // Количество подписчиков
  credentialsId   String?           // Ссылка на credentials (опционально для совместимости)
  accessToken     String            // OAuth access token
  refreshToken    String?           // OAuth refresh token
  tokenExpiry     DateTime?         // Когда истекает токен
  email           String?           // Email Google аккаунта
  isDefault       Boolean  @default(false) // Канал по умолчанию
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  credentials     YouTubeCredentials? @relation(fields: [credentialsId], references: [id], onDelete: Cascade)
  videos          Video[]
}

model VoiceConfig {
  id        String   @id @default(uuid())
  name      String   // Название конфига (например "Энергичный Дмитрий")
  voice     String   // Edge TTS voice ID (например "ru-RU-DmitryNeural")
  rate      String   @default("+0%")   // Скорость речи: -50% to +100%
  pitch     String   @default("+0Hz")  // Высота голоса: -50Hz to +50Hz
  volume    String   @default("+0%")   // Громкость: -50% to +50%
  isDefault Boolean  @default(false)   // Основной голос
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  videoVersions VideoVersion[]
}

model VideoVersion {
  id                      String   @id @default(uuid())
  videoId                 String   // ID родительского видео
  version                 Int      // Номер версии (1, 2, 3...)
  videoPath               String?  // Путь к отрендеренному видео
  segments                String?  // JSON сегментов этой версии
  voiceConfigId           String?  // ID голоса для этой версии
  backgroundMusicFilename String?  // Имя файла музыки
  isActive                Boolean  @default(false) // Активная версия для публикации
  createdAt               DateTime @default(now())

  video                   Video @relation(fields: [videoId], references: [id], onDelete: Cascade)
  voiceConfig             VoiceConfig? @relation(fields: [voiceConfigId], references: [id])

  @@unique([videoId, version])
  @@index([videoId])
}
