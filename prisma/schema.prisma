// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum VideoStatus {
  PENDING
  GENERATING_ASSETS
  RENDERING
  COMPLETED
  FAILED
}

model Video {
  id                 String      @id @default(uuid())
  status             VideoStatus @default(PENDING)
  title              String
  scriptText         String
  audioPath          String?     // Для совместимости, основные аудио в segments
  videoPath          String?
  segments           String?     // JSON массив сегментов: [{text, keywords, audioPath, audioDuration, stockVideoUrl}]
  progress           String?     // JSON с детальным прогрессом
  backgroundMusicUrl String?     // URL глобальной фоновой музыки
  tags               String?     // JSON массив тегов для YouTube
  hashtags           String?     // JSON массив хештегов для описания (#cats #коты)
  
  // YouTube публикация
  youtubeId          String?     // ID видео на YouTube
  youtubeUrl         String?     // URL видео на YouTube
  youtubeStatus      String?     // Статус: private, public, unlisted
  publishedAt        DateTime?   // Дата публикации

  createdAt          DateTime    @default(now())
}
